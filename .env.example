############################################
# signal-engine  Environment Configuration #
############################################

# --------------------
# Execution Toggles
# --------------------
# Enable real-time WebSocket ingestion (Helius)
ENABLE_WS=true

# Enable polling-based enrichment (Dexscreener)
ENABLE_DEX=true

# Enable Discord output (set false for dry analysis)
ENABLE_DISCORD=false

# Enable wallet intelligence (Helius)
ENABLE_WALLET=true

# --------------------
# Safety
# --------------------
# If true, engine runs but sends NO Discord messages
DRY_RUN=1
EXECUTION_MODE=shadow

# --------------------
# Scanner Runtime
# --------------------
# Polling interval (seconds)
SCAN_INTERVAL_SECONDS=30

# Base cooldown between alerts per token (seconds)
BASE_COOLDOWN_SECONDS=900

# --------------------
# Repeat / Heating Logic
# --------------------
# Send collapsed repeat every N repeats
COLLAPSE_EVERY=3

# Show 🔥 after this many repeats
HEATING_UP_AFTER=5

# --------------------
# Pass Escalation
# --------------------
PASS_CONFIRMATIONS=3
PASS_WINDOW_MINUTES=10
PASS_MIN_LIQUIDITY=15000
PASS_MIN_VOL5M=8000

# --------------------
# Auto-mute (anti-spam)
# --------------------
MUTE_AFTER_ALERTS=4
MUTE_WINDOW_MINUTES=15
MUTE_DURATION_MINUTES=60

# --------------------
# Daily Digest (local time if available, UTC fallback)
# --------------------
DIGEST_HOUR_LOCAL=18
DIGEST_MINUTE_LOCAL=0

# --------------------
# Discord Webhooks
# (You can reuse ONE webhook for all if desired)
# --------------------
DISCORD_WEBHOOK_NEAR_PASS=
DISCORD_WEBHOOK_PASS=
DISCORD_WEBHOOK_RUG=
DISCORD_WEBHOOK_LOGS=
DISCORD_WEBHOOK_DIGEST=

# --------------------
# Quality Signals
# --------------------
# Manually curated smart-money / KOL wallet seeds (comma-separated).
# The engine also auto-learns wallets from your own heating_up/promoted alerts.
TRACKED_SMART_WALLETS=
KOL_WALLETS=

# Narrative seeds used for early token name/symbol matching.
NARRATIVE_KEYWORDS=ai,agent,agents,defai,sol,solana,bot,terminal,swap,launchpad,game,gaming,cat,dog,frog,pepe

# Optional X / Twitter social momentum
ENABLE_X_SIGNAL=false
X_BEARER_TOKEN=
# Contract address is always added to the query even if the template omits it.
X_QUERY_TEMPLATE='"{name}" OR "${symbol}" -is:retweet -is:reply lang:en'
X_SEARCH_MAX_RESULTS=10
# Curated high-signal X accounts. Handles may include or omit @.
X_HEAVY_HANDLES=
# Optional X author IDs for high-signal accounts when handles are unstable.
X_HEAVY_AUTHOR_IDS=

# Optional explicit token discovery seeds from trackers/manual research.
# Use this for J7-style tracker exports, missed winners, or curated watchlists.
SIGNAL_ENGINE_EXTERNAL_SEED_TOKENS=

# --------------------
# Helius (Required for WS + Wallet)
# --------------------
HELIUS_API_KEY=

# --------------------
# Signal Engine V2 shadow rollout flags
# --------------------
SIGNAL_ENGINE_V2_ENABLED=false
SIGNAL_ENGINE_V2_SHADOW=true
SIGNAL_ENGINE_V2_COMPARE=false
SIGNAL_ENGINE_V2_MODEL_MODE=rules
SIGNAL_ENGINE_V2_HELIUS_TRANSACTION_SUBSCRIBE=false
SIGNAL_ENGINE_V2_JUPITER_SWAP_V2=false
SIGNAL_ENGINE_V2_BIRDEYE_STREAM=false
SIGNAL_ENGINE_V2_POSTGRES=false
SIGNAL_ENGINE_V2_VALKEY=false

# --------------------
# Worker V2 reliability slice
# --------------------
# Safe default: disabled. When enabled, the worker persists raw events,
# claims, decisions, outbox rows, cooldown reservations, checkpoints, and
# dead letters to the existing SQLite database before delivery.
SIGNAL_ENGINE_WORKER_V2_ENABLED=0

# Maximum durable processing attempts before an event is retained as a
# dead letter for manual review. No automatic replay loop is enabled.
SIGNAL_ENGINE_WORKER_V2_MAX_EVENT_ATTEMPTS=3

# Processing lease TTL in seconds. Expired leases can be reclaimed by another
# worker instance; live leases prevent simultaneous duplicate processing.
SIGNAL_ENGINE_WORKER_V2_EVENT_LEASE_SECONDS=120

# --------------------
# Manual Action Engine
# --------------------
# Safe default: disabled. When enabled, recommendations remain manual
# decision-support only and never execute trades or request wallet secrets.
SIGNAL_ENGINE_ACTION_ENGINE_ENABLED=0

# Safe default: shadow recommendations with uncalibrated labels.
SIGNAL_ENGINE_ACTION_ENGINE_SHADOW=1

# Default operator profile for recommendation calculations.
SIGNAL_ENGINE_DEFAULT_RISK_PROFILE=aggressive
SIGNAL_ENGINE_DEFAULT_EXIT_STYLE=catalyst_runner

############################################
# End of file
############################################
